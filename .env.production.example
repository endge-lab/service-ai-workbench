# Base runtime identity.
APP_ENV=production
APP_NAME=service_ai_workbench
APP_VERSION=0.1.0
REST_PORT=8080
LOGGER_LEVEL=info
PUBLIC_URL=https://ai-workbench.example.com

# Internal service: browser origins are not enabled.
CORS_ALLOWED_ORIGINS=

# PostgreSQL is optional until the concrete service adds repositories.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=disable
POSTGRES_MIGRATIONS_ENABLED=false

# Production internal API must enable the selected service-to-service auth contract.
AUTH_ENABLED=false
AUTH_SERVICE_URL=
AUTH_ISSUER=
AUTH_ALLOWED_AUDIENCES=
AUTH_JWKS_PATH=/.well-known/jwks.json
AUTH_JWKS_CACHE_TTL=5m
AUTH_SERVICE_TIMEOUT=5s

# OpenTelemetry is optional. Enable it only when you have a collector/exporter endpoint.
TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false

# Redpanda/Kafka is optional and disabled by default.
REDPANDA_ENABLED=false
REDPANDA_BROKERS=
REDPANDA_CLIENT_ID=service_ai_workbench
REDPANDA_DIAL_TIMEOUT=5s
REDPANDA_READ_BATCH_TIMEOUT=2s
REDPANDA_WRITE_TIMEOUT=10s
