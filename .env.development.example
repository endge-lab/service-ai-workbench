# Base runtime identity.
APP_ENV=development
APP_NAME=service_ai_workbench
APP_VERSION=0.2.0
REST_PORT=8081
LOGGER_LEVEL=debug
PUBLIC_URL=http://localhost:8081

# Required by service-kit; reserved .invalid origin keeps browser access disabled.
CORS_ALLOWED_ORIGINS=https://cors-disabled.invalid

# Existing PostgreSQL database. Infra never creates it automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=service_ai_workbench
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=disable
POSTGRES_MIGRATIONS_ENABLED=true

GRPC_SERVER_ENABLED=true
GRPC_SERVER_PORT=50051

# User tokens are never accepted. Only backend service identity is trusted.
AUTH_ENABLED=false
AUTH_SERVICE_URL=
AUTH_ISSUER=
AUTH_ALLOWED_AUDIENCES=
AUTH_JWKS_PATH=/.well-known/jwks.json
AUTH_JWKS_CACHE_TTL=5m
AUTH_SERVICE_TIMEOUT=5s

SERVICE_AUTH_VERIFIER_ENABLED=true
SERVICE_AUTH_ISSUER=http://localhost:8180/realms/endge-local
SERVICE_AUTH_JWKS_URL=http://localhost:8180/realms/endge-local/protocol/openid-connect/certs
SERVICE_AUTH_AUDIENCE=endge-ai-workbench
SERVICE_AUTH_ALLOWED_CALLERS=endge-service-backend
SERVICE_AUTH_ALLOWED_ALGORITHMS=RS256

# OpenTelemetry is optional and disabled by default.
TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true

# Redpanda/Kafka is optional and disabled by default.
REDPANDA_ENABLED=false
REDPANDA_BROKERS=
REDPANDA_CLIENT_ID=service_ai_workbench
REDPANDA_DIAL_TIMEOUT=5s
REDPANDA_READ_BATCH_TIMEOUT=2s
REDPANDA_WRITE_TIMEOUT=10s
